# Production template for /etc/patent-agent.env. Replace every placeholder.
DJANGO_SECRET_KEY=replace-with-generated-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=portal.example.com
CSRF_TRUSTED_ORIGINS=https://portal.example.com
SECURE_SSL_REDIRECT=true
DATABASE_URL=postgresql://patent_portal:replace_with_hex_password@127.0.0.1:5432/patent_portal
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRED=false

FASTAPI_PREDICT_URL=http://127.0.0.1:8000/predict
FASTAPI_TIMEOUT_SECONDS=6000
FASTAPI_REPORT_ROOT=/srv/patent_agent/data/reports
PORTAL_MEDIA_ROOT=/srv/patent_agent/data/portal_media
IDF_MAX_BYTES=10485760
AUDIT_DATABASE_URL=sqlite:////srv/patent_agent/patent_agent.db
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=mistral
CPC_CHROMA_PATH=/srv/patent_agent/data/chroma_db/full_cpc_db
REPORT_OUTPUT_DIR=/srv/patent_agent/data/reports

LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_PROJECT=patent-agent-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
OPENALEX_API_KEY=
SERPAPI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
ENABLE_SERPAPI_GOOGLE_SCHOLAR=false

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://portal.example.com/api/auth/google/callback/
PORTAL_FRONTEND_URL=https://portal.example.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="Patent Portal <noreply@example.com>"
