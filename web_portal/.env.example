# Copy values into the process environment for a deployment. Keep secrets out of git.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=portal.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://portal.example.com

# Leave DATABASE_URL unset for the SQLite default. For PostgreSQL, use e.g.:
# DATABASE_URL=postgresql://portal_user:password@127.0.0.1:5432/patent_portal
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRED=false

# FastAPI remains a private service behind the Django portal.
FASTAPI_PREDICT_URL=http://127.0.0.1:8000/predict
FASTAPI_TIMEOUT_SECONDS=6000
FASTAPI_REPORT_ROOT=data/reports
PORTAL_MEDIA_ROOT=data/portal_media
IDF_MAX_BYTES=10485760

# Configure SMTP for password reset emails in production.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Patent Portal <noreply@example.com>
