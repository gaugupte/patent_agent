# Local development template. Copy to .env; never put real credentials in Git.
DJANGO_SECRET_KEY=local-development-only-change-before-deploy
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DATABASE_URL unset locally to use web_portal/portal.sqlite3.
FASTAPI_PREDICT_URL=http://127.0.0.1:8000/predict
FASTAPI_TIMEOUT_SECONDS=6000
FASTAPI_REPORT_ROOT=data/reports
PORTAL_MEDIA_ROOT=data/portal_media
IDF_MAX_BYTES=10485760
AUDIT_DATABASE_URL=sqlite:///./patent_agent.db
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=mistral
CPC_CHROMA_PATH=./data/chroma_db/full_cpc_db
REPORT_OUTPUT_DIR=./data/reports

LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_PROJECT=patent-agent-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
OPENALEX_API_KEY=
SERPAPI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
ENABLE_SERPAPI_GOOGLE_SCHOLAR=false

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/auth/google/callback/
PORTAL_FRONTEND_URL=http://127.0.0.1:5173
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
